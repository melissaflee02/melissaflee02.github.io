---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
  title={`Page not found — ${site.name}`}
  description="The page you were looking for doesn't exist."
  noindex
>
  <main id="main" class="flex min-h-screen items-center px-6 py-24">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-accent-muted">
        404
      </p>
      <h1 class="mt-5 font-display text-4xl italic sm:text-5xl">
        This page wandered off.
      </h1>
      <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-ink/75">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a
        href="/"
        class="mt-9 inline-block border-b-2 border-accent/60 text-sm font-semibold uppercase tracking-wide text-accent-muted transition hover:border-accent hover:text-accent"
      >
        Back home
      </a>
    </div>
  </main>
</Layout>
