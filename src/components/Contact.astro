---
import { site } from "../data/site";

const links = [
  { label: "Email", href: site.links.email, external: false },
  { label: "LinkedIn", href: site.links.linkedin, external: true },
  { label: "GitHub", href: site.links.github, external: true },
  { label: "Resume", href: site.links.resume, external: false },
];
---

<section id="contact" class="px-6 py-16">
  <div class="mx-auto max-w-2xl border-t border-ink/15 pt-14 text-center">
    <h2 class="font-display text-3xl italic text-accent-muted">
      Let's connect
    </h2>
    <p class="mx-auto mt-3 max-w-md text-ink/75">
      Whether it's about engineering, AI, or women's wrestling — my inbox is
      always open.
    </p>
    <ul class="mt-8 flex list-none flex-wrap items-center justify-center gap-x-8 gap-y-3 text-base font-semibold">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="text-accent-muted underline decoration-accent/50 underline-offset-4 transition hover:text-accent hover:decoration-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer class="px-6 py-10 text-center text-sm text-ink/50">
  Built with Astro + Tailwind &middot; &copy; {new Date().getFullYear()}{" "}
  {site.name}
</footer>
