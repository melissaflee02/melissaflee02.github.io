---
import { projects } from "../data/projects";
---

<section id="projects" class="px-6 py-16">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-display text-3xl italic text-accent-muted">Projects</h2>
    <ul class="mt-8 grid list-none gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <li class="flex">
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-1 flex-col border-t-2 border-t-accent bg-surface p-5 transition hover:bg-canvas"
          >
            <h3 class="font-display text-xl group-hover:italic">
              {project.name}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/75">
              {project.description}
            </p>
            <ul class="mt-4 flex list-none flex-wrap gap-x-3 gap-y-1 text-xs font-semibold uppercase tracking-wide text-ink/70">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <span class="mt-4 text-sm font-semibold text-accent-muted">
              {project.linkLabel ?? "View on GitHub"} &rarr;
              <span class="sr-only">({project.name})</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
