---
import { site } from "../data/site";
---

<section id="top" class="px-6 pb-16 pt-20 sm:pt-28">
  <div class="mx-auto max-w-3xl text-center">
    <p class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-accent-muted">
      {site.tagline}
    </p>
    <h1 class="mt-5 font-display text-5xl leading-[1.1] tracking-tight sm:text-6xl">
      Hi, I'm <span class="italic text-accent">Melissa</span>.
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink/75">
      I'm a software engineer at Pinterest, building the infrastructure behind
      Homefeed, Search, Related Pins, and Notifications. When I'm not at work,
      you'll probably find me in a wrestling room, coaching the next generation
      of women wrestlers.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-6 text-sm font-semibold uppercase tracking-wide">
      <a
        href="#projects"
        class="border-b-2 border-accent/60 text-accent-muted transition hover:border-accent hover:text-accent"
      >
        See my projects
      </a>
      <a
        href="#contact"
        class="border-b-2 border-accent/60 text-accent-muted transition hover:border-accent hover:text-accent"
      >
        Get in touch
      </a>
    </div>
  </div>
  <hr class="mx-auto mt-14 max-w-xs border-t border-ink/20" />
</section>
