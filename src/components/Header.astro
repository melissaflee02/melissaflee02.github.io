---
const links = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-cream/95 backdrop-blur">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
    <a href="#top" class="font-display text-lg font-medium italic tracking-tight text-rust-dark">
      Melissa Lee
    </a>
    <ul class="flex gap-5 text-sm font-semibold uppercase tracking-wide sm:gap-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink/70 transition hover:text-rust-dark"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
